{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "android/**",
    "ios/**",
    "vendor/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    // Off. It fired on inline return types like `{ text: string | null; blocked:
    // FastPathBlock }` — a shape used once, at the function that returns it.
    // Hoisting those to named interfaces is a line of indirection per callee
    // and nothing else. It did catch real widening on annotated dictionaries;
    // those are fixed (see the `satisfies` in SeamControl and Text).
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // Off. Its advice — decode at the boundary — is worth following, and
    // src/app/json.ts is where that happens. But the rule cannot tell a
    // boundary decoder from business logic, so switching it on only bought
    // wrapper guards around single `typeof` expressions and one `Object(v) === v`
    // written to dodge it. Worse code, same behaviour.
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      // The remaining module mocks are all native modules — there is no JS
      // implementation of Reanimated's worklets, the keychain, the TTS engine,
      // the ONNX runtime or PermissionsAndroid to inject under Jest, so a mock
      // at the module boundary is the only thing there is to run against. The
      // rule stays on everywhere else, including the rest of these suites, so
      // mocking one of our own modules is still an error: every service that
      // could take its dependency as a parameter already does (the WebSocket
      // factory, the streaming fetcher, the ONNX session factory, App's
      // reachability probe).
      "files": [
        "jest.setup.js",
        "src/services/audio/__tests__/AudioCaptureService.test.ts",
        "src/services/log/__tests__/logStore.test.ts",
        "src/services/vad/__tests__/SileroVadService.test.ts"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    }
  ]
}
