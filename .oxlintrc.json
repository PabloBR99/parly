{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "android/**",
    "ios/**",
    "vendor/**",
    "tools/oxlint/anti-slop/**"
  ],
  "jsPlugins": [
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "rules": {
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    // Ad-hoc `typeof` in business logic stays an error. The exception is the
    // handful of named type guards in src/app/json.ts, which are the boundary
    // decoders this rule exists to push work into.
    "anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }],
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  },
  "overrides": [
    {
      // The remaining module mocks are all native modules — there is no JS
      // implementation of Reanimated's worklets, the keychain, the TTS engine,
      // the ONNX runtime or PermissionsAndroid to inject under Jest, so a mock
      // at the module boundary is the only thing there is to run against. The
      // rule stays on everywhere else, including the rest of these suites, so
      // mocking one of our own modules is still an error: every service that
      // could take its dependency as a parameter already does (the WebSocket
      // factory, the streaming fetcher, the ONNX session factory, App's
      // reachability probe).
      "files": [
        "jest.setup.js",
        "src/services/audio/__tests__/AudioCaptureService.test.ts",
        "src/services/log/__tests__/logStore.test.ts",
        "src/services/vad/__tests__/SileroVadService.test.ts"
      ],
      "rules": {
        "anti-slop/no-module-mocking": "off"
      }
    }
  ]
}
